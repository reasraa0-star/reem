{
  "id": "./flash-admin.html",
  "name": "Flash Mer — الإدارة",
  "short_name": "FM إدارة",
  "description": "لوحة إدارة فلاش مير: طلبات، سائقين، تجار، مدفوعات، جرد شامل",
  "lang": "ar",
  "dir": "rtl",
  "start_url": "./flash-admin.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "tabbed", "standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#070d1a",
  "theme_color": "#0b1220",
  "categories": ["business", "productivity", "shopping"],
  "prefer_related_applications": false,
  "icons": [
    {"src": "flash-icon-192.png?v=3", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "flash-icon-512.png?v=3", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "flash-icon-512.png?v=3", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "shortcuts": [
    {"name": "الطلبات", "short_name": "طلبات", "description": "عرض الطلبات الجديدة", "url": "./flash-admin.html#orders", "icons": [{"src": "flash-icon-192.png?v=3", "sizes": "192x192", "type": "image/png"}]},
    {"name": "السائقين", "short_name": "سائقين", "description": "إدارة السائقين", "url": "./flash-admin.html#drivers", "icons": [{"src": "flash-icon-192.png?v=3", "sizes": "192x192", "type": "image/png"}]},
    {"name": "التجار", "short_name": "تجار", "description": "إدارة التجار والمحلات", "url": "./flash-admin.html#shops", "icons": [{"src": "flash-icon-192.png?v=3", "sizes": "192x192", "type": "image/png"}]},
    {"name": "الجرد الشامل", "short_name": "الجرد", "description": "الجرد الشامل والمدفوعات", "url": "./flash-admin.html#inv", "icons": [{"src": "flash-icon-192.png?v=3", "sizes": "192x192", "type": "image/png"}]}
  ],
  "share_target": {
    "action": "./flash-admin.html",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {"title": "t", "text": "q"}
  },
  "file_handlers": [
    {"action": "./flash-admin.html", "accept": {"application/json": [".json"], "text/csv": [".csv"]}}
  ],
  "protocol_handlers": [
    {"protocol": "web+flashmer", "url": "./flash-admin.html?link=%s"}
  ],
  "launch_handler": {"client_mode": ["navigate-existing", "auto"]},
  "note_taking": {"new_note_url": "./flash-admin.html?note=%s"},
  "edge_side_panel": {"default_width": 420},
  "widgets": [
    {
      "id": "orders_widget",
      "name": "طلبات فلاش مير",
      "description": "يعرض عدد الطلبات الجديدة الآن",
      "lang": "ar",
      "tag": "flash-orders",
      "type": "text",
      "data_type": "application/json",
      "data": {"title": "طلبات جديدة", "count": 0},
      "icons": [{"src": "flash-icon-192.png?v=3", "sizes": "192x192", "type": "image/png"}],
      "ms_widget": {
        "id": "flashOrdersWidget",
        "default_width": 600,
        "default_height": 200,
        "min_width": 300,
        "min_height": 100,
        "icons": [{"src": "flash-icon-192.png?v=3", "sizes": "192x192", "type": "image/png"}]
      }
    }
  ]
}
